{
  "name": "farooqdrive",
  "version": "0.9.3",
  "description": "A multi-account Google Drive desktop dashboard for Windows.",
  "private": false,
  "license": "MIT",
  "author": "Mohammad Farooq",
  "main": "dist/desktop/main.cjs",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @farooqdrive/web",
    "build:web": "npm run build -w @farooqdrive/web",
    "build:desktop": "esbuild apps/desktop/src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --packages=external --outfile=dist/desktop/main.cjs",
    "build": "npm run build:web && npm run build:desktop",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:syntax": "tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.farooqdrive.desktop",
    "productName": "FarooqDrive",
    "asar": true,
    "files": [
      "dist/desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "apps/api/migrations",
        "to": "migrations",
        "filter": [
          "**/*.sql"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/FarooqDrive.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FarooqDrive",
      "deleteAppDataOnUninstall": false,
      "artifactName": "FarooqDrive-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FarooqDrive-Portable-${version}-${arch}.${ext}"
    }
  }
}
